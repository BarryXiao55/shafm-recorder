@echo off
setlocal
REM ============================================================
REM  Minimal standalone FFmpeg recorder - no Node.js required.
REM  Put ffmpeg.exe into ..\bin\ or add it to PATH first.
REM  Edit URL / SEGSEC below. Press Ctrl+C and answer Y to stop.
REM ============================================================
set "URL=https://lhttp-hw.qtfm.cn/live/270/64k.mp3"
set "SEGSEC=3600"
set "OUTDIR=%~dp0..\recordings"
set "PREFIX=FM990"
set "FFMPEG=%~dp0..\bin\ffmpeg.exe"
REM  Generated by tools\install-ffmpeg.js when installing to a custom folder.
if not exist "%FFMPEG%" if exist "%~dp0..\bin\ffmpeg-env.bat" call "%~dp0..\bin\ffmpeg-env.bat"
if exist "%FFMPEG%" goto :haveffmpeg
set "FFMPEG=ffmpeg"
where ffmpeg >nul 2>nul
if errorlevel 1 goto :noffmpeg

:haveffmpeg
if not exist "%OUTDIR%" mkdir "%OUTDIR%" 2>nul
if not exist "%OUTDIR%" goto :nodir
echo Stream : %URL%
echo Output : %OUTDIR%\%PREFIX%_0000.mp3 and so on
echo Segment: %SEGSEC% seconds, auto-reconnect on drop, stream copy (lossless)
echo.

:loop
echo [%date% %time%] connecting...
"%FFMPEG%" -hide_banner -loglevel warning -reconnect 1 -reconnect_streamed 1 -reconnect_at_eof 1 -reconnect_delay_max 10 -rw_timeout 10000000 -i "%URL%" -vn -c:a copy -id3v2_version 0 -f segment -segment_time %SEGSEC% -segment_format_options id3v2_version=0 -reset_timestamps 1 "%OUTDIR%\%PREFIX%_%%04d.mp3"
echo [%date% %time%] stream stopped, retry in 10s...
timeout /t 10 /nobreak >nul
goto loop

:noffmpeg
echo [ERROR] ffmpeg.exe not found. Run: node tools\install-ffmpeg.js
echo         Or double-click tools\install-ffmpeg.bat
pause
exit /b 1

:nodir
echo [ERROR] Cannot create output folder: %OUTDIR%
pause
exit /b 1
